{
  "name": "yclaw",
  "version": "1.0.0",
  "description": "可扩展、模块化、插件驱动的跨平台桌面工作台容器",
  "main": "dist/main/main/index.js",
  "scripts": {
    "predev": "node scripts/restore-electron-native-deps.cjs && node scripts/ensure-dev-runtime.cjs",
    "dev": "tsx scripts/dev.ts",
    "build": "npm run build:core && npm run build:features && npm run build:main",
    "build:renderer": "npm run build:core",
    "build:core": "vite build --mode core",
    "build:feature:stock": "tsx scripts/build-feature-pack.ts stock",
    "build:feature:automation": "tsx scripts/build-feature-pack.ts automation",
    "build:feature:data-center": "tsx scripts/build-feature-pack.ts data-center",
    "build:feature:plugin-center": "tsx scripts/build-feature-pack.ts plugin-center",
    "build:features": "npm run build:feature:stock && npm run build:feature:automation && npm run build:feature:data-center && npm run build:feature:plugin-center && tsx scripts/sync-feature-packs.ts",
    "build:main": "tsc -p tsconfig.main.json",
    "lint": "eslint src/ tests/ --ext .ts,.tsx",
    "lint:fix": "eslint src/ tests/ --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\"",
    "pretest": "node scripts/ensure-node-native-deps.cjs",
    "test": "vitest run",
    "posttest": "node scripts/restore-electron-native-deps.cjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "yclaw": "tsx scripts/yclaw.ts",
    "lint:tasks": "tsx scripts/yclaw.ts lint examples/tasks",
    "pack": "electron-builder --dir",
    "dist": "npm run build && electron-builder --config electron-builder.full.yml",
    "dist:mac": "npm run build && electron-builder --mac --config electron-builder.full.yml",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.full.yml",
    "dist:win:core": "npm run build:core && npm run build:main && tsx scripts/dist-win-core.ts",
    "dist:win:full": "npm run build && electron-builder --win nsis --config electron-builder.full.yml",
    "dist:linux": "npm run build && electron-builder --linux --config electron-builder.full.yml",
    "postinstall": "node -e \"if(!process.env.SKIP_POSTINSTALL){require('child_process').execSync('electron-builder install-app-deps',{stdio:'inherit'})}\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.9.0",
    "electron-log": "^5.2.4",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.3.9",
    "yaml": "^2.8.3",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.1.1",
    "@ant-design/pro-components": "^2.8.10",
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "antd": "^5.29.3",
    "electron": "^41.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "happy-dom": "^20.9.0",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.8",
    "zustand": "^5.0.2"
  },
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "author": "",
  "license": "MIT"
}
